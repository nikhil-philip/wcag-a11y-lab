# Public site settings, baked into the build. Nothing here is secret.

# Address the site is served from, with no trailing slash. Used for canonical links,
# social-media previews and the sitemap, so set it before you build for production.
VITE_SITE_URL=https://wcag-a11y-lab.pages.dev

# Shown in the footer and the page metadata. Leave a link empty to hide it.
